openapi: 3.0.3
info:
  title: RetentionOS API
  version: 1.0.0
paths:
  /api/v1/brands/:
    get:
      operationId: brands_list
      description: Brands I belong to; create a new brand (I become its Owner).
      tags:
      - brands
      security:
      - XSessionTokenAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Brand'
          description: ''
    post:
      operationId: brands_create
      description: Brands I belong to; create a new brand (I become its Owner).
      tags:
      - brands
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/BrandRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/BrandRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/BrandRequest'
        required: true
      security:
      - XSessionTokenAuth: []
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Brand'
          description: ''
  /api/v1/brands/{brand_id}/:
    get:
      operationId: brands_retrieve
      description: |-
        Every /api/v1/ view uses this (directly or via BrandScopedMixin), except the short
        exemption list in tests/test_mfa_enforcement.py (me, health, schema, public pages).
      parameters:
      - in: path
        name: brand_id
        schema:
          type: string
        required: true
      tags:
      - brands
      security:
      - XSessionTokenAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Brand'
          description: ''
    patch:
      operationId: brands_partial_update
      description: |-
        Every /api/v1/ view uses this (directly or via BrandScopedMixin), except the short
        exemption list in tests/test_mfa_enforcement.py (me, health, schema, public pages).
      parameters:
      - in: path
        name: brand_id
        schema:
          type: string
        required: true
      tags:
      - brands
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedBrandRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedBrandRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedBrandRequest'
      security:
      - XSessionTokenAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Brand'
          description: ''
  /api/v1/brands/{brand_id}/audit-log/:
    get:
      operationId: brands_audit_log_list
      description: |-
        Every /api/v1/ view uses this (directly or via BrandScopedMixin), except the short
        exemption list in tests/test_mfa_enforcement.py (me, health, schema, public pages).
      parameters:
      - in: path
        name: brand_id
        schema:
          type: string
        required: true
      tags:
      - brands
      security:
      - XSessionTokenAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/AuditLog'
          description: ''
  /api/v1/brands/{brand_id}/invitations/:
    get:
      operationId: brands_invitations_list
      description: |-
        Every /api/v1/ view uses this (directly or via BrandScopedMixin), except the short
        exemption list in tests/test_mfa_enforcement.py (me, health, schema, public pages).
      parameters:
      - in: path
        name: brand_id
        schema:
          type: string
        required: true
      tags:
      - brands
      security:
      - XSessionTokenAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Invitation'
          description: ''
    post:
      operationId: brands_invitations_create
      description: |-
        Every /api/v1/ view uses this (directly or via BrandScopedMixin), except the short
        exemption list in tests/test_mfa_enforcement.py (me, health, schema, public pages).
      parameters:
      - in: path
        name: brand_id
        schema:
          type: string
        required: true
      tags:
      - brands
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/InvitationRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/InvitationRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/InvitationRequest'
        required: true
      security:
      - XSessionTokenAuth: []
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Invitation'
          description: ''
  /api/v1/brands/{brand_id}/invitations/{invitation_id}/:
    delete:
      operationId: brands_invitations_destroy
      description: Revoke (cancel) an invitation. Owner/Admin; only an Owner can revoke
        an Owner invite.
      parameters:
      - in: path
        name: brand_id
        schema:
          type: string
        required: true
      - in: path
        name: invitation_id
        schema:
          type: string
        required: true
      tags:
      - brands
      security:
      - XSessionTokenAuth: []
      - cookieAuth: []
      responses:
        '204':
          description: No response body
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
          description: ''
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
          description: ''
        '404':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
          description: ''
  /api/v1/brands/{brand_id}/members/:
    get:
      operationId: brands_members_list
      description: |-
        Every /api/v1/ view uses this (directly or via BrandScopedMixin), except the short
        exemption list in tests/test_mfa_enforcement.py (me, health, schema, public pages).
      parameters:
      - in: path
        name: brand_id
        schema:
          type: string
        required: true
      tags:
      - brands
      security:
      - XSessionTokenAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Membership'
          description: ''
  /api/v1/brands/{brand_id}/members/{member_id}/:
    patch:
      operationId: brands_members_partial_update
      description: |-
        Every /api/v1/ view uses this (directly or via BrandScopedMixin), except the short
        exemption list in tests/test_mfa_enforcement.py (me, health, schema, public pages).
      parameters:
      - in: path
        name: brand_id
        schema:
          type: string
        required: true
      - in: path
        name: member_id
        schema:
          type: string
        required: true
      tags:
      - brands
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedMembershipRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedMembershipRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedMembershipRequest'
      security:
      - XSessionTokenAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Membership'
          description: ''
    delete:
      operationId: brands_members_destroy
      description: |-
        Every /api/v1/ view uses this (directly or via BrandScopedMixin), except the short
        exemption list in tests/test_mfa_enforcement.py (me, health, schema, public pages).
      parameters:
      - in: path
        name: brand_id
        schema:
          type: string
        required: true
      - in: path
        name: member_id
        schema:
          type: string
        required: true
      tags:
      - brands
      security:
      - XSessionTokenAuth: []
      - cookieAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/brands/{brand_id}/onboarding/:
    get:
      operationId: brands_onboarding_retrieve
      description: |-
        Every /api/v1/ view uses this (directly or via BrandScopedMixin), except the short
        exemption list in tests/test_mfa_enforcement.py (me, health, schema, public pages).
      parameters:
      - in: path
        name: brand_id
        schema:
          type: string
        required: true
      tags:
      - brands
      security:
      - XSessionTokenAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Onboarding'
          description: ''
  /api/v1/health/:
    get:
      operationId: health_retrieve
      tags:
      - health
      security:
      - XSessionTokenAuth: []
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Health'
          description: ''
  /api/v1/invitations/{token}/:
    get:
      operationId: invitations_retrieve
      description: |-
        Public: what an invitation link is for, so the invitee can sign up or log in.

        Unknown tokens get a plain 404, the same as any missing page.
      parameters:
      - in: path
        name: token
        schema:
          type: string
        required: true
      tags:
      - invitations
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/InvitationPreview'
          description: ''
        '404':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
          description: ''
        '429':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
          description: ''
  /api/v1/invitations/accept/:
    post:
      operationId: invitations_accept_create
      description: |-
        Every /api/v1/ view uses this (directly or via BrandScopedMixin), except the short
        exemption list in tests/test_mfa_enforcement.py (me, health, schema, public pages).
      tags:
      - invitations
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AcceptInvitationRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AcceptInvitationRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AcceptInvitationRequest'
        required: true
      security:
      - XSessionTokenAuth: []
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Brand'
          description: ''
  /api/v1/me/:
    get:
      operationId: me_retrieve
      description: The logged-in user's own profile.
      tags:
      - me
      security:
      - XSessionTokenAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Me'
          description: ''
    patch:
      operationId: me_partial_update
      description: The logged-in user's own profile.
      tags:
      - me
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedMeRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedMeRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedMeRequest'
      security:
      - XSessionTokenAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Me'
          description: ''
  /api/v1/me/security-events/:
    get:
      operationId: me_security_events_list
      description: |-
        My own latest 50 security events (logins, failed attempts, password and 2-step
        changes). Reachable before 2-step login is set up, like /me/.
      tags:
      - me
      security:
      - XSessionTokenAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/SecurityEvent'
          description: ''
components:
  schemas:
    AcceptInvitationRequest:
      type: object
      properties:
        token:
          type: string
          minLength: 1
      required:
      - token
    AuditLog:
      type: object
      properties:
        id:
          type: string
          readOnly: true
        action:
          type: string
          maxLength: 64
        actor_email:
          type: string
          format: email
          readOnly: true
        target_type:
          type: string
          maxLength: 64
        target_id:
          type: string
          maxLength: 64
        metadata: {}
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - action
      - actor_email
      - created_at
      - id
    Brand:
      type: object
      properties:
        id:
          type: string
          readOnly: true
        name:
          type: string
          maxLength: 120
        timezone:
          type: string
          maxLength: 64
        currency:
          type: string
          readOnly: true
        platform:
          allOf:
          - $ref: '#/components/schemas/PlatformEnum'
          readOnly: true
        status:
          allOf:
          - $ref: '#/components/schemas/BrandStatusEnum'
          readOnly: true
        my_role:
          type: string
          nullable: true
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - currency
      - id
      - my_role
      - name
      - platform
      - status
    BrandRequest:
      type: object
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 120
        timezone:
          type: string
          minLength: 1
          maxLength: 64
      required:
      - name
    BrandStatusEnum:
      enum:
      - onboarding
      - active
      - suspended
      type: string
      description: |-
        * `onboarding` - Onboarding
        * `active` - Active
        * `suspended` - Suspended
    Error:
      type: object
      description: Every API error has this shape (apps/core/exceptions.py).
      properties:
        code:
          type: string
          description: Stable machine code, e.g. "not_found".
        message:
          type: string
          description: Plain-English message that can be shown.
        details:
          description: Field errors, or {} when there are none.
      required:
      - code
      - details
      - message
    Health:
      type: object
      properties:
        status:
          type: string
      required:
      - status
    Invitation:
      type: object
      properties:
        id:
          type: string
          readOnly: true
        email:
          type: string
          format: email
          maxLength: 254
        role:
          $ref: '#/components/schemas/RoleEnum'
        status:
          allOf:
          - $ref: '#/components/schemas/InvitationStatusEnum'
          readOnly: true
          description: |-
            'expired' = the 7-day link ran out; invite again to send a new one.

            * `pending` - Pending
            * `accepted` - Accepted
            * `revoked` - Revoked
            * `expired` - Expired
        expires_at:
          type: string
          format: date-time
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - email
      - expires_at
      - id
      - role
      - status
    InvitationPreview:
      type: object
      description: What the invitee sees before logging in. No IDs, nothing else about
        the brand.
      properties:
        brand_name:
          type: string
        role:
          $ref: '#/components/schemas/RoleEnum'
        email:
          type: string
          format: email
          description: The address the invitation was sent to.
        invited_by_name:
          type: string
          description: Inviter's name, or their email.
        status:
          $ref: '#/components/schemas/InvitationStatusEnum'
        expires_at:
          type: string
          format: date-time
      required:
      - brand_name
      - email
      - expires_at
      - invited_by_name
      - role
      - status
    InvitationRequest:
      type: object
      properties:
        email:
          type: string
          format: email
          minLength: 1
          maxLength: 254
        role:
          $ref: '#/components/schemas/RoleEnum'
      required:
      - email
      - role
    InvitationStatusEnum:
      enum:
      - pending
      - accepted
      - revoked
      - expired
      type: string
      description: |-
        * `pending` - Pending
        * `accepted` - Accepted
        * `revoked` - Revoked
        * `expired` - Expired
    Me:
      type: object
      properties:
        id:
          type: string
          readOnly: true
        email:
          type: string
          format: email
          readOnly: true
        full_name:
          type: string
          maxLength: 150
        mfa:
          allOf:
          - $ref: '#/components/schemas/MfaStatus'
          readOnly: true
      required:
      - email
      - id
      - mfa
    Membership:
      type: object
      properties:
        id:
          type: string
          readOnly: true
        email:
          type: string
          format: email
          readOnly: true
        full_name:
          type: string
          readOnly: true
        role:
          $ref: '#/components/schemas/RoleEnum'
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - email
      - full_name
      - id
      - role
    MfaStatus:
      type: object
      properties:
        enabled:
          type: boolean
          description: 2-step login is set up.
        required:
          type: boolean
          description: The current policy requires it.
        deadline:
          type: string
          format: date-time
          nullable: true
          description: When it becomes blocking. Null = never.
        blocked:
          type: boolean
          description: True = the user must set up 2-step login before continuing.
      required:
      - blocked
      - deadline
      - enabled
      - required
    Onboarding:
      type: object
      properties:
        steps:
          type: array
          items:
            $ref: '#/components/schemas/OnboardingStep'
      required:
      - steps
    OnboardingStep:
      type: object
      properties:
        key:
          type: string
        title:
          type: string
        state:
          $ref: '#/components/schemas/StateEnum'
        description:
          type: string
      required:
      - description
      - key
      - state
      - title
    PatchedBrandRequest:
      type: object
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 120
        timezone:
          type: string
          minLength: 1
          maxLength: 64
    PatchedMeRequest:
      type: object
      properties:
        full_name:
          type: string
          maxLength: 150
    PatchedMembershipRequest:
      type: object
      properties:
        role:
          $ref: '#/components/schemas/RoleEnum'
    PlatformEnum:
      enum:
      - none
      - shopify
      - woocommerce
      - csv
      type: string
      description: |-
        * `none` - Not connected yet
        * `shopify` - Shopify
        * `woocommerce` - WooCommerce
        * `csv` - CSV import
    RoleEnum:
      enum:
      - owner
      - admin
      - marketer
      - viewer
      type: string
      description: |-
        * `owner` - Owner
        * `admin` - Admin
        * `marketer` - Marketer
        * `viewer` - Viewer
    SecurityEvent:
      type: object
      properties:
        id:
          type: string
          readOnly: true
        type:
          allOf:
          - $ref: '#/components/schemas/SecurityEventTypeEnum'
          readOnly: true
        description:
          type: string
          readOnly: true
          description: Plain-English line to show, e.g. 'Logged in'.
        created_at:
          type: string
          format: date-time
          readOnly: true
        ip_address:
          type: string
          readOnly: true
          nullable: true
        user_agent:
          type: string
          readOnly: true
      required:
      - created_at
      - description
      - id
      - ip_address
      - type
      - user_agent
    SecurityEventTypeEnum:
      enum:
      - login
      - login_failed
      - logout
      - email_verified
      - password_reset
      - password_changed
      - mfa_enabled
      - mfa_disabled
      - recovery_codes_generated
      type: string
      description: |-
        * `login` - Logged in
        * `login_failed` - Failed login attempt
        * `logout` - Logged out
        * `email_verified` - Email address verified
        * `password_reset` - Password reset by email link
        * `password_changed` - Password changed
        * `mfa_enabled` - 2-step login turned on
        * `mfa_disabled` - 2-step login turned off
        * `recovery_codes_generated` - New recovery codes created
    StateEnum:
      enum:
      - done
      - current
      - coming_next
      - locked
      type: string
      description: |-
        * `done` - done
        * `current` - current
        * `coming_next` - coming_next
        * `locked` - locked
  securitySchemes:
    XSessionTokenAuth:
      type: apiKey
      in: header
      name: X-Session-Token
      description: X-Session-Token authentication
    cookieAuth:
      type: apiKey
      in: cookie
      name: sessionid
