# Copy to .env for local development. Never commit real secrets (CLAUDE.md R-11).
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=retentionos
POSTGRES_USER=retentionos
POSTGRES_PASSWORD=retentionos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# 2-step login rule (D-039, U-4 open): off | signup | within_7_days
MFA_ENFORCEMENT=within_7_days
MFA_GRACE_DAYS=7
MFA_ENFORCED_ROLES=owner,admin,marketer,viewer
# Google login stays off until credentials exist
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Logs: json (staging/production) or console (readable, default when DEBUG). INFO by default.
LOG_FORMAT=console
LOG_LEVEL=INFO
# Error reporting: leave empty to keep Sentry off. It never receives personal data.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0
# Production email = Amazon SES over SMTP (only read by config/settings/production.py).
# EMAIL_HOST_USER/PASSWORD are SES *SMTP* credentials from the secrets manager, never git.
# EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=RetentionOS <no-reply@your-domain>
