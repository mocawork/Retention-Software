# Copy to .env for local development. Never commit real secrets (CLAUDE.md R-11).
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=retentionos
POSTGRES_USER=retentionos
POSTGRES_PASSWORD=retentionos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# 2-step login rule (D-039, U-4 open): off | signup | within_7_days
MFA_ENFORCEMENT=within_7_days
MFA_GRACE_DAYS=7
MFA_ENFORCED_ROLES=owner,admin,marketer,viewer
# Google login stays off until credentials exist
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
